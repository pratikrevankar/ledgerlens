# Postgres (docker-compose provides this DSN by default)
DATABASE_URL=postgresql://ledgerlens:ledgerlens@db:5432/ledgerlens

# LLM — needed for classify / extract / answer. Retrieval works without any key
# (embeddings run locally). Set one Anthropic key:
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
LLM_MODEL=claude-sonnet-5

# Optional: LangSmith tracing (set TRACING=true + a key to see every run/tool call)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ledgerlens
