# Public base URL of the LedgerLens backend. The browser calls `${NEXT_PUBLIC_API_URL}/chat`
# and `/resume`, so this must be the backend's PUBLIC origin with NO trailing slash.
#
# IMPORTANT: NEXT_PUBLIC_* is inlined at BUILD time (`next build`), not read at
# runtime — so it must be set in the Vercel project's env BEFORE the build, and a
# change requires a redeploy.
#
# Local docker-compose default:
# NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Vercel (backend deployed as its own project):
# NEXT_PUBLIC_API_URL=https://<your-backend-project>.vercel.app
NEXT_PUBLIC_API_URL=
